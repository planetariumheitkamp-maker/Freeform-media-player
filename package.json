{
  "name": "freeform-media-player",
  "version": "0.2.0",
  "description": "Cross-platform free-form media compositor with live GPU mesh warping and selectable link groups.",
  "main": "electron/main.js",
  "type": "module",
  "private": true,
  "author": "Heitkamp Planetarium",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:browser": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --publish never",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:desktop": "node scripts/verify-packaged.mjs",
    "test:present": "npm run build && node scripts/verify-present-interactive.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource/fira-mono": "^5.3.0",
    "@fontsource/fira-sans": "^5.3.0",
    "cdt2d": "^1.0.0",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "org.freeform.mediaplayer",
    "productName": "Freeform",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asar": true,
    "artifactName": "Freeform-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "Freeform uses cameras and capture devices as live media sources.",
        "NSMicrophoneUsageDescription": "Freeform uses microphones and capture-device audio as media sources.",
        "NSAudioCaptureUsageDescription": "Freeform can capture system audio with a selected desktop source.",
        "NSScreenCaptureUsageDescription": "Freeform captures windows and screens you explicitly select for mesh warping."
      }
    },
    "linux": {
      "category": "AudioVideo",
      "target": [
        "AppImage",
        "zip"
      ]
    }
  }
}
